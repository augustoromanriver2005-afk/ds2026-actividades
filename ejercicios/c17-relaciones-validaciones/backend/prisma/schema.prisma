generator client {
  provider = "prisma-client" // Prisma 7. NO "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  // sin url: en Prisma 7 la conexión va en prisma.config.ts
}

model Libro {
  id          Int         @id @default(autoincrement())
  titulo      String
  autor       Autor       @relation(fields: [autorId], references: [id]) // 1:N -> Autor
  autorId     Int
  precio      Float
  imagen      String
  descripcion String
  disponible  Boolean     @default(true)
  categorias  Categoria[] // N:M -> Categoria
}

model Autor {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}

model Categoria {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  libros Libro[]
}
